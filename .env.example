# Environment Variables for Easy-Kitchen-Backend

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/easy_kitchen

# JWT secret used to sign tokens (must be a long random string)
JWT_SECRET=change_me_to_a_long_random_secret_string

# Gmail credentials for nodemailer (if using Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Google OAuth client id for loginWithGoogle
CLIENT_ID=your-google-oauth-client-id

# Optional: upload directory for images
UPLOAD_DIR=./uploads

# Server port (optional)
PORT=3000
